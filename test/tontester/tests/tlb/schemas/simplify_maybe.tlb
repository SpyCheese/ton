// Test schema for type simplifications
nothing$0 {X:Type} = Maybe X;
just$1 {X:Type} value:X = Maybe X;

// Enum literal types
bool_false$0 = Bool;
bool_true$1 = Bool;
unit$_ = Unit;
true$1 = True;

// Using simplified enums as fields
enum_fields$_ a:Bool b:Unit c:True x:uint32 = EnumFields;

// Unary simplification
unary_zero$0 = Unary ~0;
unary_succ$1 {n:#} x:(Unary ~n) = Unary ~(n + 1);
bit$_ (## 1) = Bit;

// Sized: output param from Unary
sized$_ {n:#} len:(Unary ~n) data:(n * Bit) = Sized ~n;

// Inferred: output param through inference chain (Pair first field)
pair$_ {X:Type} {Y:Type} first:X second:Y = Pair X Y;
inferred_unary$_ {n:#} x:(Pair (Unary ~n) uint32) y:(## n) = InferredUnary ~n;

// Simple Maybe field
simple_maybe$_ x:(Maybe uint32) = SimpleMaybe;

// Maybe in a record with other fields
mixed$_ a:uint32 b:(Maybe uint64) c:int8 = Mixed;

// Nested Maybe — should NOT simplify the outer (inner is nullable)
nested_maybe$_ x:(Maybe (Maybe uint32)) = NestedMaybe;

// Maybe with ^Type
maybe_ref$_ x:(Maybe ^uint32) = MaybeRef;
